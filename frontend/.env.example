# Backend API URL (Production)
# Set this to your Render or hosted backend domain.
# Examples:
#   VITE_API_URL=https://yaba-backend.onrender.com
#   or
#   VITE_API_URL=https://yaba-backend.onrender.com/api/
VITE_API_URL=https://yaba-backend.onrender.com

# Alternatively, VITE_API_BASE_URL can also be used:
# VITE_API_BASE_URL=/api/

