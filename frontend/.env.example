# ==============================================================================
# React Frontend Environment Configuration - Yaba Fast Food
# ==============================================================================

# Production API Base URL
# If your Django backend is deployed on a separate domain (e.g. Render, Railway), set:
# VITE_API_BASE_URL=https://api.yabafastfood.com/api/
#
# If running locally or on the same domain with reverse proxy, leave empty or set:
VITE_API_BASE_URL=/api/
