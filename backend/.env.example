# ==============================================================================
# Django Backend Environment Configuration - Yaba Fast Food
# ==============================================================================

# Core Django Settings
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-50-character-random-secret-key-in-production
DJANGO_ALLOWED_HOSTS=api.yabafastfood.com,yabafastfood.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL / Supabase / Neon / Railway)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Leave empty to fall back to local SQLite db.sqlite3
DATABASE_URL=postgresql://postgres:your_supabase_password@db.your_project.supabase.co:5432/postgres

# Supabase Storage Integration (for high-speed food and gallery image uploads)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_service_key
SUPABASE_BUCKET_NAME=menu-images

# CORS & CSRF Origins (Comma-separated URLs where the React frontend is hosted)
CORS_ALLOWED_ORIGINS=https://yabafastfood.com,https://www.yabafastfood.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://yabafastfood.com,https://www.yabafastfood.com,https://api.yabafastfood.com
CORS_ALLOW_ALL_ORIGINS=False

# Email Delivery Configuration (Optional - for order confirmations and alert notifications)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password

# SSL / HTTPS Settings (Set to False only if running behind a non-SSL load balancer)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
